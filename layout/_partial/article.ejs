<% if(index){ %>
<div>
<li class="post-item">
  <%- partial('post/title') %>
  <div class="excerpt">
  <% if (item.excerpt){ %>
    <%- item.excerpt %>
  <% } else { %>
    <%- strip_html(item.content).replace(/^\s*/, '').replace(/\s*$/, '').substring(0, theme.excerpt_num) %> ...
  <% } %>
  <a href="<%- config.root %><%- item.path %>">
    <%= __("read_more") %>
  </a>
  </div>
  <div class="index-meta">
    <%- partial('post/meta', {item: item}) %>
  </div>
</li>
</div>
<hr class="index-separator">
<% } else { %>
  <article class="standard <%= item.layout %>">
    <div class="title">
      <%- partial('post/title') %>
    </div>
    <div class="meta center">
      <%- partial('post/meta', {item: item}) %>
    </div>
    <hr>
    <div class="picture-container">
      <% if (item.photos && item.photos.length){ %>
        <%- partial('post/gallery', {item: item}) %>
      <% } %>
    </div>

    <% if (item.layout === 'post') { %>
      <%
        const tocContent = toc(item.content, {
          list_number: false,
          min_depth: 2,
          max_depth: 4
        });
      %>
      <% if (tocContent && tocContent.trim()) { %>
        <button
          class="post-toc-toggle"
          type="button"
          aria-controls="post-toc-drawer"
          aria-expanded="false"
          aria-label="打开文章目录"
          title="目录">
        </button>

        <div class="post-toc-backdrop" data-toc-close aria-hidden="true"></div>

        <aside
          id="post-toc-drawer"
          class="post-toc post-toc-drawer"
          aria-label="文章目录"
          aria-hidden="true">
          <div class="post-toc-drawer-header">
            <div class="post-toc-title">目录</div>
            <button class="post-toc-close" type="button" data-toc-close aria-label="关闭文章目录">
              <i class="fa fa-times" aria-hidden="true"></i>
            </button>
          </div>
          <div class="post-toc-drawer-content">
            <%- tocContent %>
          </div>
        </aside>

        <script src="<%- url_for('/js/toc.js') %>" defer></script>
      <% } %>
    <% } %>

    <%
      // Keep <table> in its native table layout and give scrolling to a real
      // wrapper. Code examples are already HTML-escaped by the Markdown
      // renderer, so this only targets actual rendered tables in the article.
      const contentWithTableWrappers = item.content.replace(
        /<table\b([^>]*)>([\s\S]*?)<\/table>/gi,
        '<div class="table-wrapper"><table$1>$2</table></div>'
      );
    %>
    <%- contentWithTableWrappers %>

  </article>
<% } %>
