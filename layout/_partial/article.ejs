<% if(index){ %>
<div>
<li class="post-item">
  <%- partial('post/title') %>
  <div class="excerpt">
  <% if (item.excerpt){ %>
    <%- item.excerpt %>
  <% } else { %>
    <%- strip_html(item.content).replace(/^\s*/, '').replace(/\s*$/, '').substring(0, theme.excerpt_num) %> ...
  <% } %>
  <a href="<%- config.root %><%- item.path %>">
    <%= __("read_more") %>
  </a>
  </div>
  <div class="index-meta">
    <%- partial('post/meta', {item: item}) %>
  </div>
</li>
</div>
<hr class="index-separator">
<% } else { %>
  <article class="standard <%= item.layout %>">
    <div class="title">
      <%- partial('post/title') %>
    </div>
    <div class="meta center">
      <%- partial('post/meta', {item: item}) %>
    </div>
    <hr>
    <div class="picture-container">
      <% if (item.photos && item.photos.length){ %>
        <%- partial('post/gallery', {item: item}) %>
      <% } %>
    </div>

    <% if (item.layout === 'post') { %>
      <%
        const tocContent = toc(item.content, {
          list_number: false,
          min_depth: 2,
          max_depth: 4
        });
      %>
      <% if (tocContent && tocContent.trim()) { %>
        <button
          class="post-toc-toggle"
          type="button"
          aria-controls="post-toc-drawer"
          aria-expanded="false"
          aria-label="打开文章目录"
          title="目录">
        </button>

        <div class="post-toc-backdrop" data-toc-close aria-hidden="true"></div>

        <aside
          id="post-toc-drawer"
          class="post-toc post-toc-drawer"
          aria-label="文章目录"
          aria-hidden="true">
          <div class="post-toc-drawer-header">
            <div class="post-toc-title">目录</div>
            <button class="post-toc-close" type="button" data-toc-close aria-label="关闭文章目录">
              <i class="fa fa-times" aria-hidden="true"></i>
            </button>
          </div>
          <div class="post-toc-drawer-content">
            <%- tocContent %>
          </div>
        </aside>

        <script src="<%- url_for('/js/toc.js') %>" defer></script>
      <% } %>
    <% } %>

    <%
      // Keep <table> in its native table layout and give scrolling to a real
      // wrapper. Code examples are already HTML-escaped by the Markdown
      // renderer, so this only targets actual rendered tables in the article.
      const contentWithTableWrappers = item.content.replace(
        /<table\b([^>]*)>([\s\S]*?)<\/table>/gi,
        '<div class="table-wrapper"><table$1>$2</table></div>'
      );

      // Hexo server-side Highlight.js emits <pre><code class="hljs cpp">.
      // Use the existing class rather than relying on client-side detection.
      // Leave unlabeled blocks untouched; keep the original HTML inside <pre>.
      const languageNames = {
        cpp: 'C++', cxx: 'C++', 'c++': 'C++',
        csharp: 'C#', cs: 'C#',
        js: 'JavaScript', javascript: 'JavaScript',
        ts: 'TypeScript', typescript: 'TypeScript',
        md: 'Markdown', markdown: 'Markdown', scheme: 'scheme',
        html: 'HTML', xml: 'XML', css: 'CSS', scss: 'SCSS',
        json: 'JSON', yaml: 'YAML', sql: 'SQL',
        py: 'Python', python: 'Python',
        sh: 'Shell', shell: 'Shell', bash: 'Bash'
      };
      const contentWithCodeLabels = contentWithTableWrappers.replace(
        /(<pre\b[^>]*>\s*<code\b([^>]*)>[\s\S]*?<\/code>\s*<\/pre>)/gi,
        function (match, block, attributes) {
          const classMatch = attributes.match(/(?:^|\s)class\s*=\s*(["'])(.*?)\1/i);
          if (!classMatch) return block;

          const classes = classMatch[2].split(/\s+/);
          const rawLanguage = classes
            .filter(function (name) { return name !== 'hljs'; })
            .map(function (name) { return name.replace(/^language-/, ''); })
            .find(function (name) { return /^[a-z][a-z0-9_+#.-]{0,31}$/i.test(name); });

          if (!rawLanguage) return block;
          const key = rawLanguage.toLowerCase();
          const label = languageNames[key] || key[0].toUpperCase() + key.slice(1);
          // Only safe, whitelisted characters can reach this HTML attribute.
          return '<div class="code-block" data-code-language="' + label + '">' + block + '</div>';
        }
      );
    %>
    <%- contentWithCodeLabels %>

  </article>
<% } %>
